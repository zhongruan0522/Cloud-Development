# syntax=docker/dockerfile:1

# ==========================================
# 基础镜像：包含所有稳定、低频变动的组件
# 仅在手动修改本文件时才需要重建
# CI 推送到 ghcr.io/zhongruan0522/opencode-docker:base
# ==========================================

# ---
# 阶段 2：构建环境（完整工具链，产出所有制品）
# ---
FROM node:24.10.0-bookworm-slim AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG PLAYWRIGHT_MCP_VERSION=0.0.70
ARG WRANGLER_VERSION=latest
ARG EAS_CLI_VERSION=latest
ARG LARK_MCP_VERSION=latest
ARG LARK_CLI_VERSION=latest
ARG ELECTRON_VERSION=41.7.1
ARG BUN_VERSION=1.3.14
ARG PNPM_VERSION=latest
ARG ANYTHING_ANALYZER_VERSION=3.6.50
ARG FLUTTER_VERSION=3.44.4
ARG CODEGRAPH_VERSION=v1.6.0

ENV GOLANG_VERSION=1.26.4
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright \
    BUN_INSTALL=/opt/bun \
    GOPATH=/root/go
ENV PATH="/usr/local/go/bin:/root/go/bin:/opt/bun/bin:/opt/flutter/bin:${ANDROID_SDK_ROOT}/cmdline-tools/latest/bin:${ANDROID_SDK_ROOT}/platform-tools:${PATH}"

# 编译期依赖（final stage 会另行安装完整的运行时系统包）
# JDK：镜像统一只保留 Temurin 21（Debian bookworm 默认仓库不提供 OpenJDK 21，
# 经 Adoptium 仓库安装），builder 阶段装它是给 Android sdkmanager 用。
# 这里不装 Wine/locale/fonts 等 runtime-only 组件：
# 1. 多阶段最终只 COPY /usr/local、/opt、gh、Playwright 缓存和 Go modules，
#    builder 安装的这些系统包不会进入最终镜像。
# 2. Wine 仅在 final stage 需要；Windows Electron 缓存在构建期只是下载 + 解压，
#    不需要执行 Wine。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        git \
        bash \
        python3-pip \
        python3-venv \
        build-essential \
        unzip \
        xz-utils \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
       | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(awk -F= '/^VERSION_CODENAME/{print$2}' /etc/os-release) main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends temurin-21-jdk \
    && rm -rf /var/lib/apt/lists/*

# Go + Bun + pnpm
RUN curl -fsSL https://go.dev/dl/go${GOLANG_VERSION}.linux-$(dpkg --print-architecture).tar.gz | tar -C /usr/local -xzf - \
    && curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" \
    && ln -sf /opt/bun/bin/bun /usr/local/bin/bun \
    && ln -sf /opt/bun/bin/bunx /usr/local/bin/bunx \
    && rm -rf /usr/local/go/test /usr/local/go/doc /usr/local/go/misc /usr/local/go/api \
    && npm install -g pnpm@${PNPM_VERSION}

# gopls (Go 语言服务器)
RUN mkdir -p "${GOPATH}" \
    && GOBIN=/usr/local/bin go install golang.org/x/tools/gopls@latest

# govulncheck (Go 漏洞扫描工具)
RUN GOBIN=/usr/local/bin go install golang.org/x/vuln/cmd/govulncheck@latest

# Rust 工具链
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo
ENV PATH="${CARGO_HOME}/bin:${PATH}"
# 只保留 stable 工具链：nightly（含 rustc-dev/llvm-tools，~1.4G）无引用方，已移除。
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.95.0 --profile minimal \
    && rustup component add clippy rustfmt rust-src \
    && rm -rf "${RUSTUP_HOME}"/toolchains/*/share/doc \
              "${RUSTUP_HOME}"/toolchains/*/share/man

# Android SDK
RUN mkdir -p "${ANDROID_SDK_ROOT}/cmdline-tools" \
    && curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" -o /tmp/cmdline-tools.zip \
    && unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-tools \
    && mv /tmp/cmdline-tools/cmdline-tools "${ANDROID_SDK_ROOT}/cmdline-tools/latest" \
    && rm -rf /tmp/cmdline-tools.zip /tmp/cmdline-tools \
    && yes | sdkmanager --licenses > /dev/null 2>&1 \
    && sdkmanager --install \
        "build-tools;35.0.1" \
        "build-tools;30.0.2" \
        "platform-tools" \
        "platforms;android-36" \
        "platforms;android-35" \
        "platforms;android-34" \
        "platforms;android-30" \
    && ln -sf "${ANDROID_SDK_ROOT}/build-tools/35.0.1/apksigner" /usr/local/bin/apksigner \
    && ln -sf "${ANDROID_SDK_ROOT}/build-tools/35.0.1/zipalign" /usr/local/bin/zipalign \
    && rm -rf "${ANDROID_SDK_ROOT}/.temp"

# Flutter SDK（依赖上面的 Android SDK、JDK、Gradle）
# Flutter tarball 本身是 git 仓库，构建阶段以 root 运行 flutter 预热时，
# git 会因目录所有权触发 dubious ownership 报错，需配置 safe.directory。
# builder 阶段无目标用户，目录归属在最终阶段 COPY 时统一设置（默认 root）。
RUN curl -fsSL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" \
        -o /tmp/flutter.tar.xz \
    && tar -xf /tmp/flutter.tar.xz -C /opt \
    && rm -f /tmp/flutter.tar.xz \
    && git config --global --add safe.directory /opt/flutter \
    && /opt/flutter/bin/flutter --version

# Gradle 9.0
ENV GRADLE_HOME=/opt/gradle
RUN curl -fsSL "https://services.gradle.org/distributions/gradle-9.0-bin.zip" -o /tmp/gradle-9.0.zip \
    && unzip -q /tmp/gradle-9.0.zip -d /opt \
    && ln -sf /opt/gradle-9.0.0/bin/gradle /usr/local/bin/gradle \
    && rm -f /tmp/gradle-9.0.zip

# gh CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Playwright MCP（仅安装 npm 包，浏览器在下面单独装）
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g @playwright/mcp@${PLAYWRIGHT_MCP_VERSION} \
    && npm install -g @larksuite/cli@${LARK_CLI_VERSION} \
    && npm install -g @larksuiteoapi/lark-mcp@${LARK_MCP_VERSION} \
    && npm install -g wrangler@${WRANGLER_VERSION} \
    && npm install -g eas-cli@${EAS_CLI_VERSION}

# 高频全局 npm 工具
# @vscode/vsce
RUN npm install -g typescript eslint prettier esbuild tsx turbo oxlint vitest @vscode/vsce

# yarn
# Node.js 24 镜像已内置 corepack 和 yarn shim，npm install -g 会 EEXIST 冲突。
# 用 corepack prepare 固定 yarn 1.22.22 版本即可。
# 注意：corepack 只接管 yarn。pnpm 保留上面 npm 安装的真实入口——
# corepack 会按 registry latest 动态解析版本，且其 shim 硬编码 bin/pnpm.cjs，
# pnpm 12+ 已移除该文件（2026-09-06 两次动态层构建失败的根因）。
RUN corepack enable yarn && corepack prepare yarn@1.22.22 --activate

# 办公四件套 Node.js 依赖
RUN npm install -g pptxgenjs prismjs mathjax-full skia-canvas pdf-lib pdfjs-dist

# Windows Electron 二进制缓存
# electron-builder 打 Windows 包时需要 win32 平台的 electron.exe，
# 而 npm install 只会下载当前平台（linux）的二进制。
ARG ELECTRON_VERSION
RUN mkdir -p /opt/electron-cache/win32-x64 \
    && curl -fSL --retry 3 "https://github.com/electron/electron/releases/download/v${ELECTRON_VERSION}/electron-v${ELECTRON_VERSION}-win32-x64.zip" \
       -o /tmp/electron-win32-x64.zip \
    && unzip -q /tmp/electron-win32-x64.zip -d /opt/electron-cache/win32-x64 \
    && rm -f /tmp/electron-win32-x64.zip \
    && touch /opt/electron-cache/win32-x64/.version-${ELECTRON_VERSION}

# APK 反编译工具链（apktool / jadx / dex2jar / uber-apk-signer）
# Java 21 已在上面安装，所有工具基于 jar 运行
ARG APKTOOL_VERSION=3.0.2
ARG JADX_VERSION=1.5.5
ARG DEX2JAR_VERSION=2.4.35
ARG UBER_APK_SIGNER_VERSION=1.3.0
RUN mkdir -p /opt/apk-tools/bin \
    # apktool — 反编译/重打包 APK 资源和 smali
    && curl -fsSL "https://github.com/iBotPeaches/Apktool/releases/download/v${APKTOOL_VERSION}/apktool_${APKTOOL_VERSION}.jar" \
       -o /opt/apk-tools/apktool.jar \
    # jadx — dex 反编译为 Java 源码（zip 解压后 bin/ 下已有 jadx / jadx-gui 启动脚本）
    && curl -fsSL "https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/jadx-${JADX_VERSION}.zip" \
       -o /tmp/jadx.zip \
    && unzip -q /tmp/jadx.zip -d /opt/apk-tools/jadx \
    && rm -f /tmp/jadx.zip \
    # dex2jar — dex 与 jar 互转
    # 解压后根目录含 d2j-*.sh（不在 bin/ 下），lib/ 也同层，脚本靠 dirname 自身路径定位 lib
    && curl -fsSL "https://github.com/ThexXTURBOXx/dex2jar/releases/download/${DEX2JAR_VERSION}/dex-tools-${DEX2JAR_VERSION}.zip" \
       -o /tmp/dex-tools.zip \
    && unzip -q /tmp/dex-tools.zip -d /tmp/dex-tools \
    && mv /tmp/dex-tools/dex-tools-* /opt/apk-tools/dex2jar \
    && rm -rf /tmp/dex-tools /tmp/dex-tools.zip \
    # uber-apk-signer — APK 签名/zipalign/校验
    && curl -fsSL "https://github.com/patrickfav/uber-apk-signer/releases/download/v${UBER_APK_SIGNER_VERSION}/uber-apk-signer-${UBER_APK_SIGNER_VERSION}.jar" \
       -o /opt/apk-tools/uber-apk-signer.jar \
    # 创建 wrapper 脚本，使命令行可直接调用
    # apktool / uber-apk-signer：jar 入口，直接 java -jar
    && printf '#!/usr/bin/env bash\nexec java -jar /opt/apk-tools/apktool.jar "$@"\n' > /opt/apk-tools/bin/apktool \
    && printf '#!/usr/bin/env bash\nexec java -jar /opt/apk-tools/uber-apk-signer.jar "$@"\n' > /opt/apk-tools/bin/uber-apk-signer \
    # dex2jar：d2j-*.sh 用 dirname 自身路径定位 lib，绝对路径调用即可，不要 cd（否则破坏用户相对路径）
    && printf '#!/usr/bin/env bash\nexec /opt/apk-tools/dex2jar/d2j-dex2jar.sh "$@"\n' > /opt/apk-tools/bin/d2j-dex2jar \
    && printf '#!/usr/bin/env bash\nexec /opt/apk-tools/dex2jar/d2j-baksmali.sh "$@"\n' > /opt/apk-tools/bin/d2j-baksmali \
    && printf '#!/usr/bin/env bash\nexec /opt/apk-tools/dex2jar/d2j-asm-verify.sh "$@"\n' > /opt/apk-tools/bin/d2j-asm-verify \
    && chmod +x /opt/apk-tools/bin/* \
    && chmod +x /opt/apk-tools/jadx/bin/jadx /opt/apk-tools/jadx/bin/jadx-gui \
    && chmod +x /opt/apk-tools/dex2jar/d2j-*.sh

# 逆向 GUI 工具（Anything Analyzer，单一 AppImage，文件名不带架构标识）
# 注意：radare2 不在本阶段安装——其 deb 包按 Debian 布局落在 /usr，不在
# builder→final 的任何 COPY 源路径里，装在这里不会进入最终镜像；现迁至
# final 阶段层序尾部独立安装（见下方 final 的 radare2 层）。
RUN set -eux; \
    mkdir -p /opt/anything-analyzer; \
    curl -fL --retry 5 --retry-all-errors --connect-timeout 30 --max-time 900 \
      "https://github.com/Mouseww/anything-analyzer/releases/download/v${ANYTHING_ANALYZER_VERSION#v}/Anything-Analyzer-${ANYTHING_ANALYZER_VERSION}.AppImage" \
      -o /opt/anything-analyzer/anything-analyzer.AppImage; \
    chmod +x /opt/anything-analyzer/anything-analyzer.AppImage; \
    printf '#!/usr/bin/env bash\nexec /opt/anything-analyzer/anything-analyzer.AppImage --no-sandbox "$@"\n' > /usr/local/bin/anything-analyzer; \
    chmod +x /usr/local/bin/anything-analyzer

# uv (Python 包管理器)
RUN curl -fsSL https://astral.sh/uv/install.sh | env CARGO_HOME=/opt/uv UV_INSTALL_DIR=/usr/local/bin sh \
    && rm -rf /opt/uv

# 构建期一次性 venv：仅供下方 Playwright 浏览器层运行 scrapling 安装器（下载 camoufox 等）。
# 运行期 Python 包不在 builder 安装——避免经 /usr/local COPY 带入、破坏 final stage
# 的单次统一解析；统一清单见 base/install-python.sh（final stage 执行）。
RUN python3 -m venv /tmp/pw-build-venv \
    && /tmp/pw-build-venv/bin/pip install --no-cache-dir "scrapling[all]>=0.4.2"

# Playwright Chromium 浏览器（体积大头，单独一层）
# Python playwright 的 chromium 修订版对齐已随 Python 包迁至
# base/install-python.sh（final stage 执行），此处只负责
# Node 侧浏览器下载与 scrapling（构建期 venv）的浏览器安装。
RUN mkdir -p "${PLAYWRIGHT_BROWSERS_PATH}" \
    && PLAYWRIGHT_ROOT="$(npm root -g)" \
    && if [ -f "${PLAYWRIGHT_ROOT}/@playwright/mcp/node_modules/playwright/cli.js" ]; then \
         PLAYWRIGHT_CLI="${PLAYWRIGHT_ROOT}/@playwright/mcp/node_modules/playwright/cli.js"; \
       elif [ -f "${PLAYWRIGHT_ROOT}/playwright/cli.js" ]; then \
         PLAYWRIGHT_CLI="${PLAYWRIGHT_ROOT}/playwright/cli.js"; \
       elif [ -f "${PLAYWRIGHT_ROOT}/@playwright/mcp/node_modules/playwright-core/cli.js" ]; then \
         PLAYWRIGHT_CLI="${PLAYWRIGHT_ROOT}/@playwright/mcp/node_modules/playwright-core/cli.js"; \
       else \
         echo "Playwright CLI not found in ${PLAYWRIGHT_ROOT}" >&2; \
         exit 1; \
       fi \
    && PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH}" node "${PLAYWRIGHT_CLI}" install-deps chromium \
    && PLAYWRIGHT_INSTALL_PLAN="$(PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH}" node "${PLAYWRIGHT_CLI}" install --dry-run chromium)" \
    && printf '%s\n' "${PLAYWRIGHT_INSTALL_PLAN}" \
    && extract_plan_field() { \
         artifact="$1"; \
         field="$2"; \
         printf '%s\n' "${PLAYWRIGHT_INSTALL_PLAN}" | awk -v artifact="${artifact}" -v field="${field}" '\
           $0 ~ "^" artifact " " { in_block=1; next } \
           /^[^[:space:]]/ && in_block { in_block=0 } \
           in_block && index($0, field ":") { print $3; exit }'; \
       } \
    && install_archive() { \
         name="$1"; \
         install_dir="$2"; \
         download_url="$3"; \
         if [ -z "${install_dir}" ] || [ -z "${download_url}" ]; then \
           echo "Missing Playwright install data for ${name}" >&2; \
           exit 1; \
         fi; \
         tmp_zip="/tmp/playwright-${name}.zip"; \
         rm -rf "${install_dir}" "${tmp_zip}"; \
         mkdir -p "${install_dir}"; \
         echo "Downloading ${name} from ${download_url}"; \
         curl -fL --retry 5 --retry-all-errors --connect-timeout 30 --max-time 900 "${download_url}" -o "${tmp_zip}"; \
         unzip -q "${tmp_zip}" -d "${install_dir}"; \
         rm -f "${tmp_zip}"; \
         touch "${install_dir}/INSTALLATION_COMPLETE" "${install_dir}/DEPENDENCIES_VALIDATED"; \
       } \
    && install_archive chromium "$(extract_plan_field 'Chrome for Testing' 'Install location')" "$(extract_plan_field 'Chrome for Testing' 'Download url')" \
    && install_archive ffmpeg "$(extract_plan_field 'FFmpeg' 'Install location')" "$(extract_plan_field 'FFmpeg' 'Download url')" \
    && install_archive chromium-headless-shell "$(extract_plan_field 'Chrome Headless Shell' 'Install location')" "$(extract_plan_field 'Chrome Headless Shell' 'Download url')" \
    && PLAYWRIGHT_SKIP_BROWSER_GC=1 PATH="/tmp/pw-build-venv/bin:${PATH}" \
       /tmp/pw-build-venv/bin/scrapling install --force \
    && rm -rf /tmp/pw-build-venv

# CodeGraph（代码知识图谱 CLI + MCP 服务器，源码见 参考项目/codegraph）
# 自包含 bundle：内置官方 Node 24 运行时（node:sqlite + tree-sitter wasm），零原生依赖、
# 零编译，不依赖系统 Node，bookworm glibc 直接可跑。归 Base 层：CLI 工具类组件。
# 系统级安装，保证所有用户（root/主账号/desktop）与所有终端 Shell（登录/非登录/xrdp 会话/
# 非交互脚本）都能直接使用 codegraph：
#   - bundle 本体 → /opt/codegraph（versions/<v>/ + current 软链），随 /opt 整体 COPY 进最终镜像；
#   - 命令入口   → /usr/local/bin/codegraph 软链。/usr/local/bin 同时存在于镜像 ENV PATH、
#     Debian /etc/profile 登录 Shell PATH 和 PAM/xrdp 会话默认 PATH 中，任何用户任何 Shell
#     都能解析到，无需改动任何 PATH 配置。
# 已知坑（均在本机实测复现/验证过）：
#   1. install.sh 默认装 ~/.codegraph 并软链 ~/.local/bin —— 均为单用户路径，其他用户不可见，
#      且 ~/.local/bin 不在镜像 PATH 上（本机非交互 shell 即解析不到 codegraph）；
#      必须用 CODEGRAPH_INSTALL_DIR / CODEGRAPH_BIN_DIR 覆盖为系统级路径。
#   2. install.sh 的 BIN_DIR 软链直指 versions/<v>/bin/codegraph，而 `codegraph upgrade`
#      重跑 install.sh 时会 prune 掉旧 versions/<v>，直链随之变成死链（实测复现：
#      升级+prune 后直链报「没有那个文件或目录」）。故此处把入口改为经
#      /opt/codegraph/current/bin/codegraph 间接引用：升级只重指 current，入口始终有效
#      （launcher 自带 readlink 循环，链式软链可正确解析到真实 bundle 目录）。
#   3. 版本经 ARG 锁定：install.sh 默认走 GitHub releases/latest 重定向解析 latest，
#      构建不可复现（且 API 通道有 60 req/h 限流）。
#   4. 升级提示治理：root 对 /opt 有写权（最终镜像 COPY /opt），
#      `codegraph upgrade` 会就地改写 bundle，绕过镜像版本管控；且更新提示会注入
#      MCP instructions，诱导容器内 agent 尝试升级。故最终镜像统一设
#      CODEGRAPH_NO_UPDATE_CHECK=1（见下方 final stage），版本升级只走 Base 层重建。
# 版本升级方式：改 ARG CODEGRAPH_VERSION 后推送，由 build-base.yml 重建并级联上层。
# 遥测默认开启，介意者可 `codegraph telemetry off` 或设 CODEGRAPH_TELEMETRY=0（按用户级关闭，不全局设）。
RUN set -eux; \
    curl -fsSL --retry 3 "https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh" -o /tmp/codegraph-install.sh; \
    CODEGRAPH_VERSION="${CODEGRAPH_VERSION}" \
      CODEGRAPH_INSTALL_DIR=/opt/codegraph \
      CODEGRAPH_BIN_DIR=/usr/local/bin \
      sh /tmp/codegraph-install.sh; \
    rm -f /tmp/codegraph-install.sh; \
    ln -sfn /opt/codegraph/current/bin/codegraph /usr/local/bin/codegraph; \
    /usr/local/bin/codegraph --version

# Hyperframes CLI（AI 视频生成 CLI，npm 分发，latest 标记安装，升级走 Base 层重建）。
# 置于 builder 层序末尾：新增/升级本工具不会失效其上的 Playwright 浏览器、
# Electron 缓存等重层缓存。运行期自更新由 final stage 的
# HYPERFRAMES_NO_UPDATE_CHECK=1 关闭（见下）。
ARG HYPERFRAMES_VERSION=latest
RUN npm install -g hyperframes@${HYPERFRAMES_VERSION} \
    && hyperframes --version

# ---
# 阶段 2.5：下载 mihomo（Clash 内核）
# ---
FROM alpine:3.21 AS mihomo-downloader

RUN apk add --no-cache curl ca-certificates gzip

# 锁定已知可用版本，必要时构建期覆盖
ARG MIHOMO_VERSION=1.19.30
ARG TARGETARCH=amd64

RUN set -eux; \
    url="https://github.com/MetaCubeX/mihomo/releases/download/v${MIHOMO_VERSION}/mihomo-linux-${TARGETARCH}-v${MIHOMO_VERSION}.gz"; \
    curl -fsSL --retry 3 -o /tmp/mihomo.gz "${url}"; \
    gunzip /tmp/mihomo.gz; \
    install -m 755 /tmp/mihomo /usr/local/bin/mihomo

# ---
# 阶段 3：最终基础镜像（无编译工具链，从 builder 拷成品）
# ---
FROM node:24.10.0-bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive
USER root
WORKDIR /app

# 解除 node:*-slim 基础镜像的 dpkg path-exclude 规则对 /usr/share/locale/* 的剔除。
# 该规则由 debian slim 镜像注入（/etc/dpkg/dpkg.cfg.d/docker），会在 apt 安装阶段
# 直接丢弃所有 .mo 翻译文件，导致即使 LANG=zh_CN.UTF-8 且 xfce4-* 包自带 zh_CN 翻译，
# 实际文件系统里也没有任何翻译可用——XFCE 桌面、whisker 菜单、xfwm4、thunar、terminal
# 全部强制显示英文，外部表现就是"装了汉化包但实际全英文"。
# 这里删除该 dpkg 配置文件中所有 path-exclude /usr/share/locale/* 行，
# 让后续 apt install xfce4-* 时翻译文件能正常落盘。
# 同时保留 /usr/share/doc 和 /usr/share/man 的精简（不删，对汉化无关）。
RUN sed -i '/^path-exclude \/usr\/share\/locale\/\*$/d' /etc/dpkg/dpkg.cfg.d/docker \
    && if grep -qE '^path-exclude.*/usr/share/locale' /etc/dpkg/dpkg.cfg.d/docker; then \
         echo "FATAL: /usr/share/locale path-exclude still present after sed" >&2; \
         exit 1; \
       else \
         echo "OK: /usr/share/locale path-exclude removed, translations will be installed"; \
       fi

# 运行时依赖 + Playwright Chromium 系统库 + Wine
# 启用 non-free 组件，因为 unrar 仅在 non-free 仓库中提供
# Adoptium (Eclipse Temurin) 仓库 — Debian bookworm 默认仓库不提供 JDK 21
RUN sed -i 's/Components: main/Components: main non-free non-free-firmware/g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
       | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(awk -F= '/^VERSION_CODENAME/{print$2}' /etc/os-release) main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        locales \
        ca-certificates \
        curl \
        gnupg \
        git \
        bash \
        gosu \
        supervisor \
        sudo \
        openssh-client \
        openssh-server \
        python3 \
        python3-pip \
        python3-venv \
        tini \
        vim \
        wget \
        unzip \
        nano \
        tmux \
        ripgrep \
        sqlite3 \
        libsqlite3-dev \
        python-is-python3 \
        poppler-utils \
        fonts-noto-cjk \
        bubblewrap \
        iptables \
        iproute2 \
        kmod \
        gcc \
        g++ \
        make \
        cmake \
        pkg-config \
        libssl-dev \
        # 常用网络/系统诊断工具
        lsof \
        net-tools \
        procps \
        dnsutils \
        netcat-openbsd \
        strace \
        htop \
        tree \
        file \
        less \
        jq \
        # 压缩/解压工具（zip/gz/7z/bzip2/zstd/rar）
        zip \
        unzip \
        gzip \
        bzip2 \
        xz-utils \
        zstd \
        p7zip-full \
        unrar \
        # 文件同步工具
        rsync \
        temurin-21-jdk \
        libnss3 \
        libnspr4 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libgbm1 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libasound2 \
        libatspi2.0-0 \
        libpango-1.0-0 \
        libcairo2 \
        libdbus-1-3 \
        # Electron/AppImage GUI 运行时依赖
        # fuse3 提供 setuid 的 fusermount3（deb 内自带 fusermount 兼容符号链接）：
        # AppImage runtime 挂载 squashfs 自身必需，只有 libfuse2 库时
        # anything-analyzer 等 AppImage 会报 "fuse: failed to exec fusermount"。
        libfuse2 \
        fuse3 \
        libgtk-3-0 \
        libsecret-1-0 \
        libxss1 \
        libxtst6 \
        libxshmfence1 \
        xdg-utils \
        # 办公四件套运行时依赖
        libreoffice-calc \
        libreoffice-writer \
        libreoffice-impress \
        libreoffice-draw \
        libreoffice-common \
        inkscape \
        imagemagick \
        ghostscript \
        libheif-examples \
        # 文档格式转换工具（Markdown / HTML / docx 等互转）
        pandoc \
        # Wine（仅 64 位）+ NSIS。不启用 i386 多架构（wine32 连带 ~700M i386 依赖），
        # 不装 mono-complete：NSIS 不依赖 mono，如需在 wine 下运行 .NET 再单独评估。
        wine \
        wine64 \
        nsis \
    && sed -i 's/# zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/* \
    && command -v fusermount fusermount3 \
    && [ -u /bin/fusermount3 ] && [ -e /bin/fusermount ]
# 说明：xrdp/XFCE4/fcitx5 等远程桌面组件已拆分至 Dockerfile.desktop（桌面层），
# 此处仅保留 headless 场景的 GUI 运行库。

# 说明：桌面浏览器已改用 Chromium 并移至桌面层安装（见 Dockerfile.desktop），
# Base 层不再包含品牌版 Chrome Stable。
# Docker CE（DinD 模式）
RUN curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce docker-ce-cli docker-buildx-plugin docker-compose-plugin iptables \
    && rm -rf /var/lib/apt/lists/*

# xrdp 配置、Sarasa 字体、WhiteSur 主题等桌面组件已拆分至 Dockerfile.desktop（桌面层）。

# 创建架构无关的 JAVA_HOME 符号链接（仅 JDK 21，来自 Adoptium Temurin，
# Debian bookworm 默认仓库不提供 OpenJDK 21）
RUN JAVA_21_HOME="$(ls -d /usr/lib/jvm/temurin-21-* | head -1)" \
    && ln -sf "${JAVA_21_HOME}" /usr/lib/jvm/java-21-openjdk-current

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-current \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_HOME=/opt/android-sdk \
    RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    GRADLE_HOME=/opt/gradle-9.0.0

ENV PNPM_HOME="/root/.local/share/pnpm" \
    PATH="/usr/local/go/bin:/root/go/bin:/opt/bun/bin:/opt/cargo/bin:/opt/flutter/bin:/opt/gradle-9.0.0/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/build-tools/35.0.1:/opt/apk-tools/bin:/opt/apk-tools/jadx/bin:/opt/apk-tools/dex2jar:/usr/lib/jvm/java-21-openjdk-current/bin:/root/.local/share/pnpm:${PATH}" \
    GOPATH="/root/go" \
    BUN_INSTALL="/opt/bun" \
    PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright \
    PLAYWRIGHT_MCP_HEADLESS=1 \
    PLAYWRIGHT_MCP_BROWSER=chromium \
    PLAYWRIGHT_MCP_SANDBOX=0 \
    ELECTRON_CACHE=/opt/electron-cache \
    LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    LC_ALL=zh_CN.UTF-8 \
    EDITOR=vim \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    HOME=/root

# CodeGraph：关闭后台升级检测提示（builder 阶段已系统级安装，见上方注释）。
# 不关的话：更新提示会注入 MCP instructions，诱导容器内 agent/用户跑 `codegraph upgrade`
# 就地改写 /opt/codegraph（root 有写权），绕过镜像版本管控；本镜像版本升级统一走
# Base 层重建。需要时用户可临时 export CODEGRAPH_NO_UPDATE_CHECK= 覆盖。
ENV CODEGRAPH_NO_UPDATE_CHECK=1

# Hyperframes：关闭运行期更新检测与后台自更新。npm 全局目录归属 root，普通用户
# 自更新必然失败且徒增噪音；版本升级统一走 Base 层重建（同 CodeGraph 先例）。
ENV HYPERFRAMES_NO_UPDATE_CHECK=1

# 用户和目录
# 不预建任何命名用户：主账号由 entrypoint 运行期按 SSH_USER 决定（默认 root，
# root 直接运行服务；非 root 时 useradd 创建，主组归 opencode 组）。
# 数据家目录统一 /root：builder/final 构建期 HOME=/root，pnpm/uv/go/playwright
# 产物全部落在 /root 下，运行期 root 会话与服务进程同一 HOME，登录态不分裂；
# compose 挂载点同步挂在 /root/* 下。
# opencode 组（gid=10001）为功能组：desktop(10002) 加入后经组权限共享 /workspace。
# 组写权限通过 chmod g+rwx + setgid 实现：setgid 让 /workspace 下新建子目录继承组而非创建者主组。
# desktop 用户及其家目录由桌面层（Dockerfile.desktop）的 useradd --create-home 创建。
RUN groupadd --gid 10001 opencode \
    && mkdir -p /workspace /root/.config/opencode \
               /root/.cache "${PNPM_HOME}" /root/go \
    && chmod g+rwx /workspace && chmod g+s /workspace

# 从 builder 复制所有构建产物。root 属主为默认，无需显式 --chown。
COPY --from=builder /usr/local /usr/local
COPY --from=builder /opt /opt
COPY --from=builder /usr/bin/gh /usr/bin/gh
COPY --from=builder /root/.cache/ms-playwright /root/.cache/ms-playwright
COPY --from=builder /root/go/pkg/mod /root/go/pkg/mod

# 预热 Go 模块缓存，避免容器启动后反复下载大体量依赖。
# 命令化布局同 init-clash.sh：脚本常驻 /usr/local/bin/install-go.sh，
# 运行期可手动重跑预热；仍为独立镜像层，仅改清单只失效本层。
COPY base/install-go.sh /usr/local/bin/install-go.sh
RUN chmod +x /usr/local/bin/install-go.sh \
    && /usr/local/bin/install-go.sh

# 预装运行期 Python 包（原 builder 内联安装迁入，清单见 base/install-python.sh，
# 含 Python playwright chromium 修订版对齐）。与 Go 模块预热同理收敛为独立层：
# 仅改清单只失效本层，不拖累 builder 的 Playwright Chromium 下载等重层。
COPY base/install-python.sh /usr/local/bin/install-python.sh
RUN chmod +x /usr/local/bin/install-python.sh \
    && /usr/local/bin/install-python.sh

# mihomo（Clash 内核）
# 放在 Go 模块 / Python 包预热之后：mihomo-only 升级不会让耗时较长的预热层失效。
COPY --from=mihomo-downloader /usr/local/bin/mihomo /usr/local/bin/mihomo

# === 容器启动 / 进程管理脚本（base/，仅 Base 归属部分） ===
COPY base/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY base/healthcheck.sh /usr/local/bin/healthcheck.sh
COPY base/init-clash.sh /usr/local/bin/init-clash.sh
COPY base/supervisord.conf /etc/supervisor/supervisord.conf
# install-go.sh / install-python.sh 已随各自预热层 COPY 到 /usr/local/bin，不在此重复。
# init-desktop.sh / xrdp-startwm.sh 归桌面层（Dockerfile.desktop），此处不再 COPY。
# 桌面环境配置/资源（desktop/**）同样归桌面层。

RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/healthcheck.sh /usr/local/bin/init-clash.sh

# === FFmpeg（Hyperframes CLI doctor 必需项，通用音视频转码工具，含 ffprobe）===
# 独立层置于层序尾部：本层新增/升级不失效其上 Chrome、Docker CE、Go/Python 预热等
# 既有层。libgomp1 为 whisper-cli（下一层）与 torch 的运行时依赖。
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && ffmpeg -version | head -n1

# === whisper.cpp（whisper-cli，Hyperframes CLI doctor 检查项）===
# 转录模型不预置（首次使用按需下载，doctor 只检查二进制存在性）。
# GGML_NATIVE=OFF 使二进制不绑定构建机 CPU 指令集；BUILD_SHARED_LIBS=OFF 产出
# 自包含静态二进制，免搬运 libggml 动态库。版本经 ARG 锁定，升级走 Base 层重建。
ARG WHISPER_CPP_VERSION=v1.9.4
RUN git clone --depth 1 --branch "${WHISPER_CPP_VERSION}" https://github.com/ggml-org/whisper.cpp /tmp/whisper.cpp \
    && cmake -S /tmp/whisper.cpp -B /tmp/whisper.cpp/build -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF -DBUILD_SHARED_LIBS=OFF \
    && cmake --build /tmp/whisper.cpp/build --config Release -j"$(nproc)" --target whisper-cli \
    && cp /tmp/whisper.cpp/build/bin/whisper-cli /usr/local/bin/whisper-cli \
    && rm -rf /tmp/whisper.cpp \
    && whisper-cli --help > /dev/null

# === Hyperframes CLI 环境自检（构建期门禁，检查失败即构建失败）===
# `doctor --json` 恒以 0 退出，必须按 checks 内容断言。整体 ok 还含两类运行时状态，
# 构建期无从满足、不在断言范围：
#   - "Docker running"：构建期无 dockerd，容器运行期经 ENABLE_DOCKERD=1 或
#     supervisorctl start dockerd 拉起；
#   - "/dev/shm"：docker run 默认 64MB，需运行时 shm-size ≥ 256MB
#     （docker-compose.yml 已设 2gb）。
RUN hyperframes doctor --json > /tmp/hyperframes-doctor.json \
    && jq -r '.checks[] | "\(.ok)  \(.name): \(.detail)"' /tmp/hyperframes-doctor.json \
    && failed="$(jq '[.checks[] | select(.name | IN("Version","Node.js","CPU","Memory","Disk","Frames cache","Archive extractor","Environment","whisper-cpp","TTS (Kokoro)","BGM (MusicGen)","FFmpeg","FFprobe","Chrome","Docker")) | select(.ok | not)] | length' /tmp/hyperframes-doctor.json)" \
    && echo "hyperframes doctor failed checks: ${failed}" \
    && [ "${failed}" -eq 0 ] \
    && rm -f /tmp/hyperframes-doctor.json

# === radare2（逆向 CLI 工具链：r2 / rabin2 等）===
# 必须装在最终镜像阶段：radare2 是完整 apt 包（/usr/bin/r2、/usr/lib/radare2/* 等，
# 按 Debian 布局落在 /usr），不在 builder→final 的任何 COPY 源路径里，也无法像 gh CLI
# 那样单二进制搬运（r2 依赖 libr_* 动态库）——论证同上方 Chrome。
# 历史 bug：曾装在 builder 阶段，产物从未进入最终镜像（2026-09-26 环境审计发现修复）。
# 独立层置于层序尾部：新增/升级本工具不失效其上任何既有层。
ARG RADARE2_VERSION=6.1.6
RUN set -eux; \
    r2_arch="$(dpkg --print-architecture)"; \
    case "${r2_arch}" in amd64|arm64) ;; *) echo "Unsupported radare2 architecture: ${r2_arch}" >&2; exit 1 ;; esac; \
    curl -fsSL --retry 3 "https://github.com/radareorg/radare2/releases/download/${RADARE2_VERSION}/radare2_${RADARE2_VERSION}_${r2_arch}.deb" -o /tmp/radare2.deb; \
    apt-get update && apt-get install -y --no-install-recommends /tmp/radare2.deb && rm -rf /var/lib/apt/lists/*; \
    rm -f /tmp/radare2.deb; \
    r2 -v && rabin2 -v

# docker 组成员身份运行期注入：非 root 主账号（SSH_USER != root）由 entrypoint 在
# useradd 后执行 usermod -aG docker（组由 docker-ce 包安装时创建）。DinD dockerd
# 拉起后 /var/run/docker.sock 属 root:docker 且 0660，需组成员身份才能使用 docker CLI
# （Hyperframes doctor "Docker running" 检查同此依赖）。SSH_USER=root 时天然属 root，无需处理。

WORKDIR /workspace

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
