<?xml version="1.0" encoding="UTF-8"?>
<!-- XFCE 桌面（xfdesktop）默认配置 —— 极简纯色背景
     不装任何壁纸包；image-show=false + color-style=0（纯色填充）。
     颜色 #2f343f（中性深灰蓝，浅色文字可读）。
     color 数组为 16 位 RGBA（0-65535），8 位色值 × 257 换算：
       0x2f=47→12079  0x34=52→13364  0x3f=63→16191 -->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="image-show" type="bool" value="false"/>
        <property name="color-style" type="int" value="0"/>
        <property name="color1" type="array">
          <value type="uint" value="12079"/>
          <value type="uint" value="13364"/>
          <value type="uint" value="16191"/>
          <value type="uint" value="65535"/>
        </property>
      </property>
      <property name="monitor1" type="empty">
        <property name="image-show" type="bool" value="false"/>
        <property name="color-style" type="int" value="0"/>
        <property name="color1" type="array">
          <value type="uint" value="12079"/>
          <value type="uint" value="13364"/>
          <value type="uint" value="16191"/>
          <value type="uint" value="65535"/>
        </property>
      </property>
    </property>
  </property>
</channel>
