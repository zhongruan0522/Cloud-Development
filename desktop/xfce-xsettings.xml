<?xml version="1.0" encoding="UTF-8"?>
<!-- XFCE xsettings 默认配置（极简）：仅中文字体与渲染，主题走系统默认
     语言：XFCE 界面语言跟随 Base 层镜像 ENV LANG=zh_CN.UTF-8，无需在此设置
     字体：Noto Sans CJK SC / Noto Sans Mono CJK SC（Base 层 fonts-noto-cjk）
     渲染：次像素 RGB + 轻微 Hinting，提升 RDP 远程显示清晰度

     ⚠️ 若指定主题，ThemeName/IconThemeName 必须在 /Net/ 下，否则完全不生效；
     本文件不指定主题，xfsettingsd 回落 GTK 默认（Adwaita + hicolor 图标）。

     参考：
       https://github.com/xfce-mirror/xfce4-settings/blob/master/xfsettingsd/xsettings.xml
       https://www.freedesktop.org/wiki/Specifications/XSettingsRegistry/ -->
<channel name="xsettings" version="1.0">
  <property name="Xft" type="empty">
    <!-- DPI：96 是 xrdp 默认 -->
    <property name="DPI" type="int" value="96"/>
    <!-- AntiAlias：1=开启，远程桌面强烈建议开 -->
    <property name="Antialias" type="int" value="1"/>
    <!-- Hinting：-1=自动（XFCE 上游默认） -->
    <property name="Hinting" type="int" value="-1"/>
    <!-- HintStyle：hintslight（轻微 hinting 对应 Subpixel）-->
    <property name="HintStyle" type="string" value="hintslight"/>
    <!-- RGBA：次像素 RGB 排列，提升 RDP 下文字锐度 -->
    <property name="RGBA" type="string" value="rgb"/>
  </property>
  <property name="Gtk" type="empty">
    <!-- 字体（FontName 在 /Gtk/ 下，符合 XSETTINGS 规范） -->
    <property name="FontName" type="string" value="Noto Sans CJK SC 10"/>
    <property name="MonospaceFontName" type="string" value="Noto Sans Mono CJK SC 11"/>
    <property name="ToolbarStyle" type="int" value="2"/>
    <property name="MenuImages" type="bool" value="true"/>
    <property name="ButtonImages" type="bool" value="true"/>
    <property name="CanChangeAccels" type="bool" value="false"/>
    <property name="DialogsUseHeader" type="bool" value="false"/>
  </property>
</channel>
