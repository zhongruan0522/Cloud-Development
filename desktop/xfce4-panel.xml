<?xml version="1.0" encoding="UTF-8"?>
<!-- XFCE4 任务栏（xfce4-panel）默认配置 —— 极简单面板
      单面板贴顶撑满屏宽 30px，XFCE 经典默认结构：
        应用程序菜单 → 窗口按钮（tasklist）→ 弹性分隔 → 系统托盘 → 中文时钟
      为什么这个文件不能省：
      XFCE 在没有 xfconf 默认配置时，xfce4-panel 首启用 hardcoded 默认值，
      实际结构随版本漂移不可控；显式单面板保证每次登录结构一致。
      所用插件全部为 xfce4-panel 内建类型，无需 whiskermenu 等额外插件包；
      面板文字（"应用程序"等）由 xfce4-panel 自带的 zh_CN 翻译按 LANG 渲染。

      字段参考（XFCE 4.18，Debian bookworm 版本）：
        position p=6     顶部居左（snapped to top edge）
        length 100       百分比（配合 length-adjust=false 严格撑满屏宽）
        size             panel 高度 px
        autohide-behavior 0=常驻 1=始终隐藏 2=intelligent（窗口触边时隐藏）
      文档：
        https://docs.xfce.org/xfce/xfce4-panel/start
        https://docs.xfce.org/xfce/xfconf/start -->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>

  <!-- 所有插件的实例声明：plugin-N 的 value 是插件内部类型名 -->
  <property name="plugins" type="empty">
    <!-- 1: 应用程序菜单（applicationsmenu，内建插件；只显示图标，语言随系统为中文） -->
    <property name="plugin-1" type="string" value="applicationsmenu">
      <property name="show-button-title" type="bool" value="false"/>
    </property>
    <!-- 2: 窗口按钮（tasklist）：合并同应用、扁平按钮、显示标题（经典 XFCE 布局） -->
    <property name="plugin-2" type="string" value="tasklist">
      <property name="grouping" type="bool" value="true"/>
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="sort-order" type="int" value="1"/>
      <property name="show-labels" type="bool" value="true"/>
      <property name="show-handle" type="bool" value="false"/>
    </property>
    <!-- 3: 弹性分隔符，把托盘/时钟顶到面板最右 -->
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="bool" value="false"/>
    </property>
    <!-- 4: 系统托盘（systray），收纳 fcitx5 输入法图标 -->
    <property name="plugin-4" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
    </property>
    <!-- 5: 时钟，24 小时制中文格式：月日 周几 时:分 -->
    <property name="plugin-5" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-format" type="string" value="%m月%d日 %a %R"/>
    </property>
  </property>

  <property name="panels" type="array">
    <value type="int" value="1"/>
    <!-- ======== 面板 1：顶部单面板（XFCE 默认位置）======== -->
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="length-adjust" type="bool" value="false"/>
      <property name="size" type="uint" value="30"/>
      <property name="icon-size" type="uint" value="0"/>
      <property name="nrows" type="uint" value="1"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="autohide-behavior" type="uint" value="0"/>
      <property name="output-name" type="string" value="Primary"/>
      <property name="enable-struts" type="bool" value="true"/>
      <!-- 插件顺序：应用程序菜单 → 窗口按钮 → 弹性分隔 → 托盘 → 时钟 -->
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
      </property>
    </property>
  </property>
</channel>
