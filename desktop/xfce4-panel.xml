<?xml version="1.0" encoding="UTF-8"?>
<!-- XFCE4 任务栏（xfce4-panel）默认配置 —— macOS WhiteSur 双面板结构
      面板 1（顶部菜单栏，对齐 macOS Menu Bar）：
        - 贴顶撑满屏宽 32px，半透明深底白字
        - 内容：apple logo 启动器（Whisker Menu）→ 窗口按钮（tasklist，紧凑排列居左）
               → 弹性分隔 → 系统托盘（fcitx5/通知图标）→ 时钟（右侧，周 月日 时间）
      面板 2（底部 Dock 栏，对齐 macOS Dock）：
        - 贴底居中，autohide（intelligent：遮挡时显示），64px 大图标
        - 内容：launcher 快捷方式（终端/工作区/浏览器/OpenCode）
               → 弹性分隔由 length 百分比模拟居中
        - 说明：macOS Dock 的"放大动画 + 指示灯"XFCE launcher 插件做不到，
          视觉上的圆角半透明底板由 plank（WhiteSur 官方 dock 主题）负责，
          本面板 plank 启动后自动隐藏（intelligent 模式），作为无 plank 时的兜底。
          若 plank 常驻，可把本面板 autohide 改 1（always）彻底隐藏。

      为什么这个文件不能省：
      XFCE 在没有 xfconf 默认配置时，xfce4-panel 首启用 hardcoded 默认值——
      单面板在屏幕顶部、用老式 applicationsmenu。这就是登录后"结构完全不像 macOS"
      的根因。装了 xfce4-whiskermenu-plugin 但没这份配置，panel 不会自动启用它。

      字段参考（XFCE 4.18，Debian bookworm 版本）：
        position p=6     顶部居左（snapped to top edge）
        position p=8     底部居中
        length 100       百分比（配合 length-adjust=false 严格撑满屏宽）
        size             panel 高度 px
        autohide-behavior 0=常驻 1=始终隐藏 2=intelligent（窗口触边时隐藏）
      文档：
        https://docs.xfce.org/xfce/xfce4-panel/start
        https://docs.xfce.org/xfce/xfconf/start -->
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>

  <!-- 所有插件的实例声明：plugin-N 的 value 是插件内部类型名 -->
  <property name="plugins" type="empty">
    <!-- 1: Whisker Menu（菜单本体，顶部栏最左，apple logo 按钮）
         darkstyle=1 + button-icon=自定义路径，对齐 macOS  -->
    <property name="plugin-1" type="string" value="whiskermenu">
      <property name="button-icon" type="string" value="/usr/share/icons/WhiteSur/panel-apple.svg"/>
      <property name="show-button-title" type="bool" value="false"/>
      <property name="menu-width" type="int" value="540"/>
      <property name="menu-height" type="int" value="640"/>
      <property name="item-icon-size" type="int" value="3"/>
      <property name="category-icon-size" type="int" value="2"/>
      <property name="launcher-show-name" type="bool" value="true"/>
      <property name="launcher-show-description" type="bool" value="true"/>
      <property name="launcher-show-tooltip" type="bool" value="true"/>
      <property name="hover-switch-category" type="bool" value="true"/>
      <property name="recent-items-max" type="int" value="10"/>
      <property name="favorites" type="array">
        <value type="string" value="opencode-terminal.desktop"/>
        <value type="string" value="opencode-workspace.desktop"/>
        <value type="string" value="opencode-browser.desktop"/>
        <value type="string" value="opencode-webui.desktop"/>
      </property>
    </property>
    <!-- 2: 窗口按钮（tasklist），顶部栏中段，macOS 菜单栏中显示 App 名的区域。
         show-labels=false 只显示图标（macOS 菜单栏不放窗口标题），
         grouping=合并同应用，flat-buttons 扁平无边框 -->
    <property name="plugin-2" type="string" value="tasklist">
      <property name="grouping" type="bool" value="true"/>
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="sort-order" type="int" value="1"/>
      <property name="show-labels" type="bool" value="false"/>
      <property name="show-handle" type="bool" value="false"/>
    </property>
    <!-- 3: 弹性分隔符，把托盘/时钟顶到菜单栏最右 -->
    <property name="plugin-3" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="bool" value="false"/>
    </property>
    <!-- 4: 系统托盘（systray），收纳 fcitx5 输入法、通知图标 -->
    <property name="plugin-4" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
    </property>
    <!-- 5: 时钟，macOS 菜单栏风格：周几 月日 + 24 小时制时间 -->
    <property name="plugin-5" type="string" value="clock">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-format" type="string" value="%m月%d日 %a %R"/>
    </property>
    <!-- 6-10: 底部 Dock 栏 launcher（macOS Dock 常驻图标）。
             move=TRUE 使新窗口最小化到 Dock（贴近 macOS 点击图标还原） -->
    <property name="plugin-6" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="opencode-terminal.desktop"/>
      </property>
    </property>
    <property name="plugin-7" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="opencode-workspace.desktop"/>
      </property>
    </property>
    <property name="plugin-8" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="opencode-browser.desktop"/>
      </property>
    </property>
    <property name="plugin-9" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="opencode-webui.desktop"/>
      </property>
    </property>
  </property>

  <property name="panels" type="array">
    <value type="int" value="1"/>
    <value type="int" value="2"/>
    <!-- ======== 面板 1：顶部菜单栏（macOS Menu Bar）======== -->
    <property name="panel-1" type="empty">
      <!-- 贴顶撑满屏宽 32px：macOS 菜单栏高度约 24-25px，32px 在 RDP 下更易点中 -->
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="length-adjust" type="bool" value="false"/>
      <property name="size" type="uint" value="32"/>
      <property name="icon-size" type="uint" value="0"/>
      <property name="nrows" type="uint" value="1"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="autohide-behavior" type="uint" value="0"/>
      <property name="output-name" type="string" value="Primary"/>
      <property name="enable-struts" type="bool" value="true"/>
      <!-- 插件顺序：apple菜单 → 窗口区 → 弹性分隔 → 托盘 → 时钟 -->
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
      </property>
    </property>
    <!-- ======== 面板 2：底部 Dock 栏（plank 常驻时作为兜底自动隐藏）======== -->
    <property name="panel-2" type="empty">
      <!-- 贴底居中，长度约 60% 模拟 Dock 居中浮动；plank 起来后 intelligent 隐藏 -->
      <property name="position" type="string" value="p=8;x=0;y=0"/>
      <property name="length" type="uint" value="55"/>
      <property name="length-adjust" type="bool" value="false"/>
      <property name="size" type="uint" value="56"/>
      <property name="icon-size" type="uint" value="0"/>
      <property name="nrows" type="uint" value="1"/>
      <property name="position-locked" type="bool" value="true"/>
      <!-- intelligent：plank 未跑时 Dock 可用；plank 跑起来遮到底部时自动让位 -->
      <property name="autohide-behavior" type="uint" value="2"/>
      <property name="output-name" type="string" value="Primary"/>
      <!-- Dock 栏不占 struts：plank 浮动压在窗口上，底部面板隐藏时窗口可全屏贴底 -->
      <property name="enable-struts" type="bool" value="false"/>
      <!-- 插件顺序：终端 → 工作区 → 浏览器 → OpenCode -->
      <property name="plugin-ids" type="array">
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
      </property>
    </property>
  </property>
</channel>
