# syntax=docker/dockerfile:1

# ==========================================
# 桌面层镜像：xrdp + XFCE4 极简中文远程桌面
# FROM 基础镜像（ghcr.io/zhongruan0522/opencode-docker:base）
# 仅在桌面组件（xrdp/XFCE/桌面配置）变动时重建，
# Base 层完全复用缓存；本层被动态层（Dockerfile）FROM 引用。
# CI 推送到 ghcr.io/zhongruan0522/opencode-docker:desktop
#
# 定位：极简 XFCE——单面板 + 纯色桌面 + 系统默认 GTK/图标主题，
# 不引入第三方主题、壁纸、dock 等美化组件。
# 中文系统语言由 Base 层提供（ENV LANG=zh_CN.UTF-8 + locale-gen zh_CN.UTF-8
# + fonts-noto-cjk + 已解除 dpkg 对 /usr/share/locale 的 path-exclude），
# 本层继承后 XFCE 面板/菜单/Thunar/终端界面即为中文；中文输入法用 fcitx5。
#
# 层排序策略与动态层一致：更新频率从低到高排列。
# 桌面包 apt（低频，最重）→ Anything Analyzer AppImage（低频）
# → desktop 用户（极少变）→ 桌面配置文件（相对高频）
# ==========================================

ARG BASE_IMAGE=ghcr.io/zhongruan0522/opencode-docker:base
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG ANYTHING_ANALYZER_VERSION=3.6.50

# ---
# 1. 桌面 apt 包（xrdp + XFCE4 核心 + 中文输入法，最低频最重层）
# ---
# xrdp/xorgxrdp 提供 RDP 协议接入，xfwm4 是 XFCE 默认窗口管理器
# XFCE4 是 GTK 实现的成熟轻量桌面环境，对 xrdp 容器场景支持最好
# （linuxserver/webtop、dorowu/ubuntu-desktop 等都选用 XFCE）
# 不用 LXQt 的原因：lxqt-panel 在无系统 D-Bus 容器里首次生成的 panel.conf
# 颜色会被错误序列化为 @Variant(...\\x00*6) 即 RGB(0,0,0)，导致黑底黑字隐形
# xfce4 元包在 --no-install-recommends 下即为核心组件集
# （xfwm4/xfce4-panel/xfce4-session/xfdesktop4/thunar/xfce4-settings/xfconf 等）；
# 单面板所需插件（applicationsmenu/tasklist/separator/systray/clock）均为
# xfce4-panel 内建类型，不装 whiskermenu 等第三方插件包。
# dbus-x11 + dbus + policykit-1：补齐系统总线，让 polkit/udisks2 正常工作
# fcitx5 + fcitx5-chinese-addons + gtk3 前端提供中文输入法（XFCE 走 GTK）
# 构建期门禁（fail-fast）：校验 Base 层中文底座确实存在——zh_CN locale
# 与 Noto CJK 字体缺一，桌面登录即是英文/豆腐块，问题应暴露在构建期而非运行期。
# 说明：chromium（含 chromium-browser 包装器）已在 Base 层安装——hyperframes doctor
# 依赖它（构建期门禁），桌面层直接继承，此处不重复安装。
# 说明：fonts-noto-cjk、libgtk-3-0、xdg-utils、locales 已在 Base 层
# （headless 渲染与系统语言也依赖），通过层继承获得，不重复声明。
# 说明：thunar 由 xfce4 元包 Depends 带入（thunar >= 4.18.0），不显式声明；
# opencode-workspace.desktop 快捷方式与 Thunar 挂载能力依赖它，随元包获得。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        xrdp \
        xorgxrdp \
        xfce4 \
        xfce4-terminal \
        dbus \
        dbus-x11 \
        policykit-1 \
        fcitx5 \
        fcitx5-frontend-gtk3 \
        fcitx5-chinese-addons \
    && usermod -aG ssl-cert xrdp \
    && locale -a 2>/dev/null | grep -qi '^zh_CN\.utf8$' \
    && fc-list :family | grep -qx 'Noto Sans CJK SC' \
    && rm -rf /var/lib/apt/lists/*

# ---
# 2. Anything Analyzer（逆向协议分析 GUI 工具，低频）
# ---
# Electron GUI 应用（官方无 CLI/headless 模式，MCP Server 也在 GUI 设置内启用），
# 必须有 X 会话才能启动——归属桌面层而非 Base 层：slim 变体无显示服务器，
# 装了也无法运行，纯属死重。AppImage runtime 需要 fuse3 提供的 setuid
# fusermount3 挂载自身 squashfs（只有 libfuse2 库会报
# "fuse: failed to exec fusermount"）；fuse 包是全镜像唯一 AppImage 的专属
# 依赖，随工具一并放在本层。
RUN apt-get update \
    && apt-get install -y --no-install-recommends fuse3 libfuse2 \
    && rm -rf /var/lib/apt/lists/* \
    && command -v fusermount fusermount3 \
    && [ -u /bin/fusermount3 ] && [ -e /bin/fusermount ] \
    && mkdir -p /opt/anything-analyzer \
    && curl -fL --retry 5 --retry-all-errors --connect-timeout 30 --max-time 900 \
      "https://github.com/Mouseww/anything-analyzer/releases/download/v${ANYTHING_ANALYZER_VERSION#v}/Anything-Analyzer-${ANYTHING_ANALYZER_VERSION}.AppImage" \
      -o /opt/anything-analyzer/anything-analyzer.AppImage \
    && chmod +x /opt/anything-analyzer/anything-analyzer.AppImage \
    && printf '#!/usr/bin/env bash\nexec /opt/anything-analyzer/anything-analyzer.AppImage --no-sandbox "$@"\n' > /usr/local/bin/anything-analyzer \
    && chmod +x /usr/local/bin/anything-analyzer

# ---
# 3. xrdp 配置（低频）
# ---
# - xrdp.ini: 端口改为 3390（避免与宿主机 RDP 默认 3389 冲突），
#             降低 crypt_level 到 client 兼容更多客户端，禁用 bitmap_cache 减少内存占用
# - startwm.sh: 启动 dbus 会话总线 + fcitx5 中文输入法 + XFCE4 会话
#   通过 COPY desktop/xrdp-startwm.sh 注入（见文件末尾 COPY 块）
# 参考：https://github.com/neutrinolabs/xrdp/discussions/2309（容器内无 systemd 时需手动启动 xrdp）
RUN sed -i \
    -e 's/^port=3389/port=3390/' \
    -e 's/^max_bpp=32/max_bpp=24/' \
    -e 's/^crypt_level=high/crypt_level=client/' \
    -e 's/^bitmap_cache=true/bitmap_cache=false/' \
    -e 's/^#\?tcp_send_buffer_bytes=.*/tcp_send_buffer_bytes=4194304/' \
    /etc/xrdp/xrdp.ini \
    && echo "==> xrdp 已配置（端口 3390）"

# ---
# 4. 应用菜单 Chromium 条目改走包装器（低频）
# ---
# Debian chromium 包自带的 /usr/share/applications/chromium.desktop 是
# Exec=/usr/bin/chromium %U，直连二进制、绕过 Base 层包装器
# /usr/local/bin/chromium-browser（root 下自动加 --no-sandbox）：
# root 桌面登录后从应用菜单点 "Chromium 网页浏览器" 会复现
# "Running as root without --no-sandbox is not supported" 拒绝启动。
# 改指包装器后与桌面快捷方式 / hyperframes 走同一入口，root 与 desktop 账号行为一致。
# 归属桌面层：改的是"应用菜单"行为（仅桌面场景消费），slim 变体无菜单无需此修正，
# 放 Base 层会触发月级全量重建，代价不成比例。
# fail-fast：替换后不得残留指向裸二进制的 Exec 行（上游包 desktop 文件格式变化时立即暴露）。
RUN sed -i 's|^Exec=/usr/bin/chromium |Exec=chromium-browser |' /usr/share/applications/chromium.desktop \
    && if grep -q '^Exec=/usr/bin/chromium' /usr/share/applications/chromium.desktop; then \
         echo "FATAL: chromium.desktop Exec 改写失败，上游 desktop 文件格式可能已变化" >&2; \
         exit 1; \
       fi \
    && echo "==> 应用菜单 Chromium 条目已改走 chromium-browser 包装器"

# ---
# 5. desktop 用户（极少变动）
# ---
# 独立日常账号（可 sudo），作为推荐 RDP/SSH 登录账号。
# 运行期用户名可通过 DESKTOP_USER 环境变量改名（entrypoint/init-desktop.sh 处理），
# 镜像内固定叫 desktop（uid=10002）。
# 加入 opencode 组（gid=10001，Base 层创建的功能组）：与主账号共享 /workspace 组权限。
# 密码在 entrypoint.sh 运行时由 DESKTOP_USER_PASSWORD/DESKTOP_PASSWORD 注入，这里仅建账户。
# uid=10002 固定，entrypoint 的 LOCAL_UID 调整逻辑只针对主账号，不会动 desktop，保证桌面登录始终是普通权限。
# CARGO_HOME 按用户拆分：镜像级 ENV CARGO_HOME=/opt/cargo 为 root:root 只读，
# desktop 用户 cargo build 连 registry 下载缓存与 .package-cache 锁文件都写不了，
# 必然失败。/opt/cargo/bin（rustup 代理命令，PATH 绝对路径）与 RUSTUP_HOME=
# /opt/rustup（rustc/clippy/rustfmt 工具链）保持全局只读共享不受影响；仅
# registry/git 缓存与 cargo install 产物落家目录——Rust 官方镜像生态对 non-root
# 用户的同款标准做法。写 ~/.bashrc：桌面终端（xrdp 会话 source /etc/profile 后
# 终端再读用户 bashrc，覆盖顺序正确）、SSH 登录（.profile → .bashrc）、su - 均
# 生效；非交互 docker exec -u desktop 不生效，此时 cargo build 会响亮失败而非
# 静默落错位置。root 用户语义不变（继续用 /opt/cargo）。
# PNPM_HOME / GOPATH 同理补齐（随 pnpm 全局资产迁 /opt/pnpm 一并处理）：
# - pnpm：镜像预装资产在 /opt/pnpm 只读共享，desktop 用户级 pnpm add -g 须落
#   自家目录（/root 0700 不可指回；profile.d 已按 HOME 展开，此处兜住不经
#   /etc/profile 加载链的交互 shell，同 CARGO_HOME 覆盖顺序论证）。
# - go：镜像 GOPATH=/root/go 的 GOMODCACHE 对 desktop 不可读写，go build 会
#   直接失败；重定向 $HOME/go 后模块缓存按用户自建（镜像预热的 /root/go/pkg/mod
#   本就不可穿透，无损失），go install 产物同样落自家。
RUN useradd --create-home --shell /bin/bash --uid 10002 --gid 10001 desktop \
    && usermod -aG sudo desktop \
    && echo 'desktop ALL=(ALL:ALL) ALL' > /etc/sudoers.d/desktop \
    && chmod 440 /etc/sudoers.d/desktop \
    && printf '# CARGO_HOME: registry 缓存与 cargo install 产物落家目录（/opt/cargo 只读，见 Dockerfile.desktop）\nexport CARGO_HOME="$HOME/.cargo"\nexport PATH="$HOME/.cargo/bin:$PATH"\n' >> /home/desktop/.bashrc \
    && printf '# PNPM_HOME: 用户级 pnpm 全局安装落家目录（镜像预装资产在 /opt/pnpm 只读共享）\nexport PNPM_HOME="$HOME/.local/share/pnpm"\nexport PATH="$PNPM_HOME/bin:$PATH"\n# GOPATH: Go 模块缓存与 go install 产物落家目录（镜像 GOPATH=/root/go 对 desktop 不可穿透）\nexport GOPATH="$HOME/go"\nexport PATH="$GOPATH/bin:$PATH"\n' >> /home/desktop/.bashrc

# ---
# 6. 桌面环境配置 / 脚本 / 快捷方式（desktop/，相对高频，放最后）
# ---
# 桌面快捷方式：同时放入应用菜单和 opencode 专用启动器目录
COPY desktop/launchers/opencode-*.desktop /usr/local/share/opencode-desktop-launchers/
COPY desktop/launchers/opencode-*.desktop /usr/share/applications/
# 桌面默认配置（极简 XFCE，中文）：
# - xfce-xsettings.xml：中文字体（Noto Sans CJK SC，Base 层 fonts-noto-cjk）
#   + 字体渲染；GTK/图标主题不指定，走系统默认（Adwaita + hicolor）
# - xfce4-panel.xml：单面板（顶部）：应用程序菜单 → 窗口按钮 → 托盘 → 中文时钟；
#   缺它则 xfce4-panel 首启用 hardcoded 默认值，面板结构随版本漂移不可控
# - xfce-desktop.xml：纯色桌面背景（不装任何壁纸包）
# xfwm4 无配置文件：完全走内置默认（Default 主题、右侧窗口按钮布局）
# 界面语言：XFCE 是 GTK 应用，跟随 Base 层镜像 ENV LANG=zh_CN.UTF-8 显示中文
COPY desktop/xfce-xsettings.xml /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
COPY desktop/xfce4-panel.xml /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
COPY desktop/xfce-desktop.xml /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml

# ---
# 7. 桌面启动脚本（desktop/ 中的桌面专属部分）
# ---
# init-desktop.sh：entrypoint 在 ENABLE_DESKTOP=1 时调用的 root 级桌面引导
# xrdp-startwm.sh：xrdp 会话启动脚本（dbus + fcitx5 + XFCE4）
COPY desktop/init-desktop.sh /usr/local/bin/init-desktop.sh
COPY desktop/xrdp-startwm.sh /etc/xrdp/startwm.sh

RUN chmod +x /usr/local/bin/init-desktop.sh /etc/xrdp/startwm.sh \
    && chmod 755 /usr/local/share/opencode-desktop-launchers/opencode-*.desktop /usr/share/applications/opencode-*.desktop
